# ═══════════════════════════════════════════════════════════
# GitHub Token 配置
# ═══════════════════════════════════════════════════════════

# 方式 1: 单 token（最简单，5000 req/hr）
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here

# 方式 2: 多 token 轮换池（推荐，N × 5000 req/hr）
# 逗号分隔，自动选剩余配额最多的那个
# GITHUB_TOKENS=ghp_alice_token,ghp_bob_token,ghp_carol_token
#
# ⚠️ 重要：同一 GitHub 账号的多个 token 共享同一个 5000/hr 配额！
# 池中的 token 必须来自【不同 GitHub 账号】才能叠加配额。
# 例如：团队 3 人各贡献 1 个 token = 3 × 5000 = 15000 req/hr
#
# 优先级：GITHUB_TOKENS > GITHUB_PERSONAL_ACCESS_TOKEN > GITHUB_TOKEN

# 怎么拿 token:
#   1. https://github.com/settings/tokens
#   2. 推荐用 Fine-grained token（更安全）:
#      - "Generate new token" → "Fine-grained personal access token"
#      - Repository access: Public Repositories (read-only)
#      - Permissions → Repository: Issues (Read-only), Pull requests (Read-only)
#      - 过期时间建议 90 天
#   3. 或者 Classic token（更简单）:
#      - "Generate new token (classic)"
#      - 勾 public_repo
#   4. 对于私有仓库（如 ROCm/aiter）: 需要 repo scope (classic) 或对应仓库的完整权限 (fine-grained)

# ⚠️ 安全提示：
# - 创建此文件后运行 chmod 600 .env
# - 此文件已被 .gitignore 排除，切勿提交到 Git
# - Token 泄露到公开仓库会被 GitHub 自动吊销

# ═══════════════════════════════════════════════════════════
# 路径覆盖（可选，一般不用改）
# ═══════════════════════════════════════════════════════════
# SIGNALS_DB_PATH=data/signals.db
# CACHE_DIR=data/cache
# CONFIG_PATH=config/sources.yaml
