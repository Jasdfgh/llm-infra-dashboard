GITHUB_TOKEN=your_github_token_here
OPENAI_API_KEY=not-needed
OPENAI_BASE_URL=http://your-llm-gateway:31355/v1
OPENAI_MODEL=your-model-name

# ═══════════════════════════════════════════════════════════
# Signal Ingestion (Module 1 + 3) — GitHub Token
# ═══════════════════════════════════════════════════════════

# Single token (5000 req/hr)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here

# Multi-token rotation pool (recommended, N × 5000 req/hr)
# Comma-separated. Tokens MUST be from DIFFERENT GitHub accounts
# to stack quotas (same account = shared 5000/hr).
# GITHUB_TOKENS=ghp_alice_token,ghp_bob_token,ghp_carol_token
